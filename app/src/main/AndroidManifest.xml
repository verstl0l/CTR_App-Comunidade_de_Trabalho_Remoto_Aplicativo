<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".CTRApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.CTR"
        tools:targetApi="31">

        <!-- SPLASH (LAUNCHER) -->
        <activity
            android:name=".Splash"
            android:exported="true"
            android:theme="@style/Theme.CTR">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- ✅ TELAS COM TECLADO (adjustResize — teclado empurra o conteúdo) -->
        <activity
            android:name=".LoginActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".CadastroActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".CriarEquipeActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".GerenciarEquipeActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".CriarTrabalhoActivity"
            android:windowSoftInputMode="adjustResize" />

        <!-- TELAS SEM TECLADO -->
        <activity android:name=".MainActivity" />
        <activity android:name=".participantes" />
        <activity android:name=".produtos" />
        <activity android:name=".perfil" />

        <!-- OUTRAS TELAS -->
        <activity
            android:name=".ConvidarTrabalhoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".PedirEntradaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".EntregarTrabalhoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <meta-data
            android:name="CLOUDINARY_URL"
            android:value="cloudinary://@fqb729sb" />

        <activity
            android:name=".BuscarEquipesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- ✅ CHATS — adjustResize (teclado empurra o input) -->
        <activity
            android:name=".ChatActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ChatEquipeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ChatGrupoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ListaConversasActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".PerfilUsuarioActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".GruposActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".InfoEquipeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MinhasEquipesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".GerenciarMembrosGrupoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".VisualizarMidiaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".GaleriaMidiaActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ProdutividadeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".MensagensFavoritasActivity"
            android:exported="false" />
        <activity
            android:name=".NotificacoesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- uCrop -->
        <activity
            android:name="com.yalantis.ucrop.UCropActivity"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.AppCompat.Light.NoActionBar" />

        <!-- android-video-trimmer -->
        <activity
            android:name="com.gowtham.library.ui.ActVideoTrimmer"
            android:screenOrientation="portrait"
            android:theme="@style/VideoTrimmerTheme"
            tools:replace="android:theme" />

        <!-- ✅ NOVAS TELAS -->
        <activity
            android:name=".AnexosTrabalhoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".AceitarConviteActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ComentariosTrabalhoActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".PreviewMidiaActivity"
            android:exported="false"
            android:theme="@style/Theme.MaterialComponents.NoActionBar"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".PedidosPendentesActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>