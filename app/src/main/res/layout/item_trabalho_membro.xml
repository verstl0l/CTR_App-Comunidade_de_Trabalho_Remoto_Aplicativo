<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardBackgroundColor="@color/bg_surface_light"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Titulo + Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtTituloTrabalhoMembro"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Titulo do Trabalho"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtStatusTrabalhoMembro"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/bg_surface_hover"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Em Progresso"
                android:textColor="@color/accent"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Prazo -->
        <TextView
            android:id="@+id/txtPrazoTrabalhoMembro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Entrega: 18 Out"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Descricao -->
        <TextView
            android:id="@+id/txtDescricaoTrabalhoMembro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Descricao do trabalho..."
            android:textColor="@color/text_tertiary"
            android:textSize="14sp" />

        <!-- "Quem mais esta na tarefa" -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Quem mais esta na tarefa"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Avatares + Botoes -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Avatares (decorativos por enquanto) -->
            <View
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/ic_launcher_foreground"
                android:backgroundTint="@color/accent" />

            <View
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="-8dp"
                android:background="@drawable/ic_launcher_foreground"
                android:backgroundTint="@color/bg_surface_hover" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <!-- Botao anexos -->
            <Button
                android:id="@+id/btnAnexosMembro"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:padding="8dp"
                android:text="0"
                android:textColor="@color/text_secondary"
                android:textSize="16sp" />

            <!-- Botao INICIAR/CONCLUIR -->
            <Button
                android:id="@+id/btnEntregarTrabalho"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/bg_surface_hover"
                android:text="INICIAR"
                android:textColor="@color/text_primary" />

        </LinearLayout>

        <!-- Contador de anexos (opcional) -->
        <TextView
            android:id="@+id/txtContadorAnexosMembro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text=""
            android:textColor="@color/accent"
            android:textSize="12sp"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>