<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <!-- Indicador de resposta (canto esquerdo, sobreposto) -->
    <ImageView
        android:id="@+id/imgIndicadorResposta"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:contentDescription="@string/chat_responder_desc"
        android:src="@android:drawable/ic_menu_revert"
        android:visibility="gone"
        app:tint="@color/accent" />

    <!-- Balao: vem depois do indicador para ficar por cima -->
    <LinearLayout
        android:id="@+id/containerBalao"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/txtNomeRemetenteMensagem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            android:text="@string/item_mensagem_nome_placeholder"
            android:textColor="@color/accent"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/containerCitacao"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="6dp"
            android:background="@color/bg_surface_hover"
            android:minWidth="120dp"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtNomeCitado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/item_mensagem_nome_placeholder"
                android:textColor="@color/accent"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtTextoCitado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:ellipsize="end"
                android:maxLines="2"
                android:maxWidth="240dp"
                android:text="@string/item_mensagem_citacao_placeholder"
                android:textColor="@color/text_secondary"
                android:textSize="12sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/txtTextoMensagem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="280dp"
            android:text="@string/item_mensagem_texto_placeholder"
            android:textColor="@color/text_primary"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/txtHoraMensagem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:text=""
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

    </LinearLayout>

</RelativeLayout>