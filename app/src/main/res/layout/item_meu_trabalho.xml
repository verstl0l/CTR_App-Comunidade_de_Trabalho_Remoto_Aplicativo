<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Titulo + Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtTituloMeuTrabalho"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/meus_trabalhos_item_titulo_placeholder"
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtStatusMeuTrabalho"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/bg_surface_hover"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="@string/status_pendente"
                android:textColor="@color/accent"
                android:textSize="11sp" />

        </LinearLayout>

        <!-- Equipe -->
        <TextView
            android:id="@+id/txtEquipeMeuTrabalho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/meus_trabalhos_equipe_fallback"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Prazo -->
        <TextView
            android:id="@+id/txtPrazoMeuTrabalho"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/meus_trabalhos_prazo_placeholder"
            android:textColor="@color/text_secondary"
            android:textSize="14sp" />

        <!-- Descricao -->
        <TextView
            android:id="@+id/txtDescricaoMeuTrabalho"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:ellipsize="end"
            android:maxLines="3"
            android:text="@string/meus_trabalhos_descricao_placeholder"
            android:textColor="@color/text_tertiary"
            android:textSize="14sp" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>