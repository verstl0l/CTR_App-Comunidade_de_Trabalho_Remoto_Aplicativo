<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardBackgroundColor="@color/bg_surface"
    app:cardCornerRadius="12dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Título + Status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtTituloTrabalhoHistorico"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:text="@string/meus_trabalhos_item_titulo_placeholder"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/txtStatusTrabalhoHistorico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="@string/status_pendente"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>

        <!-- Info (categoria + prazo) -->
        <TextView
            android:id="@+id/txtInfoTrabalhoHistorico"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/item_trabalho_placeholder_info"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <!-- Contadores -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/txtQtdComentariosHistorico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@color/bg_surface_hover"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="@string/historico_trabalho_qtd_comentarios"
                android:textColor="@color/accent"
                android:textSize="11sp" />

            <TextView
                android:id="@+id/txtQtdAnexosHistorico"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@color/bg_surface_hover"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:text="@string/historico_trabalho_qtd_anexos"
                android:textColor="@color/accent"
                android:textSize="11sp" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>